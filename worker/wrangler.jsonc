{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "circumsurvey-api",
  "main": "src/index.js",
  "compatibility_date": "2026-04-01",
  "workers_dev": true,

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "circumsurvey",
      "database_id": "9018c642-05c8-4335-93cc-4282c5e7ff12"
    }
  ],

  "routes": [
    {
      "pattern": "findings.circumsurvey.online/api/*",
      "zone_name": "circumsurvey.online"
    }
  ],

  "observability": {
    "enabled": true
  },

  "ai": {
    "binding": "AI"
  },

  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "circumsurvey-narratives"
    }
  ],

  "vars": {
    "SYNTH_PROVIDER": "gemini",
    "GEMINI_MODEL": "gemini-2.5-flash",
    "CF_SYNTH_MODEL": "@cf/meta/llama-3.1-8b-instruct-fp8-fast",
    "CF_ROUTER_MODEL": "@cf/meta/llama-3.1-8b-instruct-fp8-fast"
  }

  // Rate limiting is configured via the Cloudflare Dashboard for jsonc configs.
  // NO "assets" key — this is a pure API worker.
}
