// ========================================================================
// CIRCUMSURVEY — HARMONIC RIBBONS (classic)
//
// Two big horizontal-sweeping ribbons of tweened lines drifting across
// the viewport. Each ribbon is defined by two bezier boundary curves
// (A and B); ~40 parallel strokes are drawn as linear interpolations
// between A and B. A single along-x linear gradient is applied to every
// stroke so the color runs WARM → HOT → VIOLET → COOL across the screen,
// matching the report's editorial palette.
//
// No map-morphing, no figure tracking — purely ambient atmosphere.
// `data-harmonic-hero` sections get a bolder opacity; everything else
// is soft backdrop.
// ========================================================================

(function () {
  const PARAMS = {
    steps:        38,      // parallel strokes per ribbon (tween density)
    samples:      280,     // points per polyline
    lineWidth:    0.55,    // uniform thin stroke
    driftRadius:  0.045,   // ambient drift, fraction of min(w,h)
    driftSpeed:   0.00010,
    opacityAmb:   0.55,
    opacityHero:  0.95,
    fadeSpring:   0.04
  };

  // ---------- color helpers ----------
  function parseColor(cssVar, fallback) {
    const raw = getComputedStyle(document.documentElement).getPropertyValue(cssVar).trim();
    if (!raw) return fallback;
    if (raw.startsWith("#")) {
      const hex = raw.length === 4
        ? raw.slice(1).split("").map(c => parseInt(c + c, 16))
        : [parseInt(raw.slice(1,3),16), parseInt(raw.slice(3,5),16), parseInt(raw.slice(5,7),16)];
      return hex;
    }
    const m = raw.match(/(\d+)\s*,\s*(\d+)\s*,\s*(\d+)/);
    if (m) return [+m[1], +m[2], +m[3]];
    return fallback;
  }
  const rgba = (c, a) => `rgba(${c[0]},${c[1]},${c[2]},${a})`;
  const lerp = (a, b, t) => a + (b - a) * t;

  // ---------- polyline geometry ----------
  function resampleUniform(pts, N) {
    if (pts.length < 2) {
      return Array.from({ length: N }, () => ({ x: pts[0]?.x || 0.5, y: pts[0]?.y || 0.5 }));
    }
    const arc = [0];
    for (let i = 1; i < pts.length; i++) {
      const dx = pts[i].x - pts[i-1].x;
      const dy = pts[i].y - pts[i-1].y;
      arc.push(arc[i-1] + Math.hypot(dx, dy));
    }
    const total = arc[arc.length - 1] || 1;
    const out = new Array(N);
    let cur = 0;
    for (let i = 0; i < N; i++) {
      const target = (i / (N - 1)) * total;
      while (cur < arc.length - 2 && arc[cur + 1] < target) cur++;
      const a = arc[cur], b = arc[cur + 1];
      const t = b > a ? (target - a) / (b - a) : 0;
      out[i] = {
        x: pts[cur].x + (pts[cur + 1].x - pts[cur].x) * t,
        y: pts[cur].y + (pts[cur + 1].y - pts[cur].y) * t
      };
    }
    return out;
  }

  function bezierControlsToPolyline(ctrl, N) {
    const segs = (ctrl.length - 1) / 3;
    const PER = 24;
    const dense = [];
    for (let s = 0; s < segs; s++) {
      const p0 = ctrl[s*3], c1 = ctrl[s*3+1], c2 = ctrl[s*3+2], p1 = ctrl[s*3+3];
      for (let q = 0; q < PER; q++) {
        const t = q / PER;
        const it = 1 - t, it2 = it*it, it3 = it2*it, t2 = t*t, t3 = t2*t;
        dense.push({
          x: it3*p0.x + 3*it2*t*c1.x + 3*it*t2*c2.x + t3*p1.x,
          y: it3*p0.y + 3*it2*t*c1.y + 3*it*t2*c2.y + t3*p1.y
        });
      }
    }
    dense.push({ x: ctrl[ctrl.length-1].x, y: ctrl[ctrl.length-1].y });
    return resampleUniform(dense, N);
  }

  // ---------- ARCHETYPES ----------
  // Each archetype is one ribbon (curveA = top boundary, curveB = bottom).
  // The 38 tweened strokes between them form the "fanned" Harmony band.
  // Curves start off the left edge and exit off the right so the ribbon
  // sweeps fully across the viewport.
  const ARCHETYPES = [
    {
      // Upper ribbon — gentle sine sweeping high
      curveA: [
        { x: -0.10, y:  0.18 },
        { x:  0.15, y: -0.05 }, { x:  0.30, y:  0.55 }, { x:  0.45, y:  0.30 },
        { x:  0.60, y:  0.10 }, { x:  0.78, y:  0.65 }, { x:  0.82, y:  0.42 },
        { x:  0.95, y:  0.10 }, { x:  1.05, y:  0.30 }, { x:  1.10, y:  0.22 }
      ],
      curveB: [
        { x: -0.10, y:  0.45 },
        { x:  0.18, y:  0.30 }, { x:  0.32, y:  0.80 }, { x:  0.48, y:  0.55 },
        { x:  0.62, y:  0.38 }, { x:  0.80, y:  0.85 }, { x:  0.85, y:  0.60 },
        { x:  0.98, y:  0.35 }, { x:  1.05, y:  0.55 }, { x:  1.10, y:  0.45 }
      ]
    },
    {
      // Lower ribbon — counter-sine sweeping low, partially crossing the upper
      curveA: [
        { x: -0.10, y:  0.55 },
        { x:  0.15, y:  0.80 }, { x:  0.30, y:  0.30 }, { x:  0.46, y:  0.55 },
        { x:  0.58, y:  0.85 }, { x:  0.74, y:  0.40 }, { x:  0.84, y:  0.62 },
        { x:  0.96, y:  0.90 }, { x:  1.06, y:  0.60 }, { x:  1.10, y:  0.72 }
      ],
      curveB: [
        { x: -0.10, y:  0.80 },
        { x:  0.18, y:  1.05 }, { x:  0.32, y:  0.55 }, { x:  0.48, y:  0.78 },
        { x:  0.60, y:  1.05 }, { x:  0.76, y:  0.65 }, { x:  0.86, y:  0.82 },
        { x:  0.98, y:  1.10 }, { x:  1.06, y:  0.82 }, { x:  1.10, y:  0.95 }
      ]
    }
  ];

  // ---------- INIT ----------
  function init() {
    const canvas = document.createElement("canvas");
    canvas.className = "harmonic-canvas";
    canvas.setAttribute("aria-hidden", "true");
    document.body.insertBefore(canvas, document.body.firstChild);

    const ctx = canvas.getContext("2d");
    const dpr = Math.min(window.devicePixelRatio || 1, 2);

    // Build ribbon stacks
    let stacks;
    function buildStacks() {
      stacks = ARCHETYPES.map((arch) => {
        const archA = bezierControlsToPolyline(arch.curveA, PARAMS.samples);
        const archB = bezierControlsToPolyline(arch.curveB, PARAMS.samples);
        // Per-point drift parameters — each sample point gets its own
        // slow phase + frequency so the ribbon "breathes" organically.
        const drift = archA.map(() => ({
          fxA: 0.6 + Math.random() * 0.8,
          fyA: 0.6 + Math.random() * 0.8,
          pxA: Math.random() * Math.PI * 2,
          pyA: Math.random() * Math.PI * 2,
          fxB: 0.6 + Math.random() * 0.8,
          fyB: 0.6 + Math.random() * 0.8,
          pxB: Math.random() * Math.PI * 2,
          pyB: Math.random() * Math.PI * 2
        }));
        return {
          archA, archB, drift,
          drawAx: new Float32Array(PARAMS.samples),
          drawAy: new Float32Array(PARAMS.samples),
          drawBx: new Float32Array(PARAMS.samples),
          drawBy: new Float32Array(PARAMS.samples)
        };
      });
    }
    buildStacks();

    function resize() {
      const w = window.innerWidth, h = window.innerHeight;
      canvas.width = w * dpr; canvas.height = h * dpr;
      canvas.style.width = w + "px"; canvas.style.height = h + "px";
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }
    window.addEventListener("resize", resize);
    resize();

    // ---------- ALONG-X GRADIENT ----------
    // One linear gradient running left → right across the viewport.
    // Read from CSS custom properties so it tracks the theme.
    let gradient = null;
    function rebuildGradient() {
      const warm   = parseColor("--warm",   [255, 176,  0]);
      const hot    = parseColor("--hot",    [255,  59, 138]);
      const violet = parseColor("--violet", [184, 137, 255]);
      const cool   = parseColor("--cool",   [ 93, 210, 255]);
      const ink    = parseColor("--ink",    [127, 224, 127]);
      const g = ctx.createLinearGradient(0, 0, window.innerWidth, 0);
      g.addColorStop(0.00, rgba(warm,   0.85));
      g.addColorStop(0.28, rgba(hot,    0.85));
      g.addColorStop(0.55, rgba(violet, 0.85));
      g.addColorStop(0.80, rgba(cool,   0.85));
      g.addColorStop(1.00, rgba(ink,    0.85));
      gradient = g;
    }
    rebuildGradient();
    window.addEventListener("resize", rebuildGradient);
    new MutationObserver(rebuildGradient).observe(document.documentElement, {
      attributes: true, attributeFilter: ["data-theme"]
    });

    // ---------- HERO TRACKING ----------
    // Sections marked data-harmonic-hero get the bolder opacity.
    const heroVisible = new Set();
    const heroSections = document.querySelectorAll("[data-harmonic-hero]");
    if (heroSections.length) {
      const io = new IntersectionObserver((entries) => {
        entries.forEach(e => {
          if (e.isIntersecting) heroVisible.add(e.target);
          else heroVisible.delete(e.target);
        });
      }, { threshold: 0.15 });
      heroSections.forEach(s => io.observe(s));
    }

    let running = !document.hidden;
    document.addEventListener("visibilitychange", () => {
      running = !document.hidden;
      if (running) lastT = performance.now();
    });

    let lastT = performance.now();
    const MIN_FRAME = 1000 / 30;
    let displayedOpacity = 0;
    const t0 = performance.now();

    // Per-stroke scratch buffers
    const px = new Float32Array(PARAMS.samples);
    const py = new Float32Array(PARAMS.samples);

    function drawStack(stack) {
      const STEPS = PARAMS.steps, N = PARAMS.samples;
      ctx.lineWidth = PARAMS.lineWidth;
      ctx.strokeStyle = gradient;

      for (let k = 0; k <= STEPS; k++) {
        const t = k / STEPS;
        const it = 1 - t;

        // Tween this stroke's polyline between ribbon edges A and B.
        for (let i = 0; i < N; i++) {
          px[i] = stack.drawAx[i] * it + stack.drawBx[i] * t;
          py[i] = stack.drawAy[i] * it + stack.drawBy[i] * t;
        }

        // Catmull-Rom as cubic beziers so the stroke flows smoothly
        // through every sample point.
        ctx.beginPath();
        ctx.moveTo(px[0], py[0]);
        const last = N - 1;
        for (let i = 0; i < last; i++) {
          const im1 = i > 0 ? i - 1 : 0;
          const ip2 = i + 2 < N ? i + 2 : last;
          const c1x = px[i]   + (px[i+1] - px[im1]) / 6;
          const c1y = py[i]   + (py[i+1] - py[im1]) / 6;
          const c2x = px[i+1] - (px[ip2] - px[i])   / 6;
          const c2y = py[i+1] - (py[ip2] - py[i])   / 6;
          ctx.bezierCurveTo(c1x, c1y, c2x, c2y, px[i+1], py[i+1]);
        }
        ctx.stroke();
      }
    }

    function frame(now) {
      requestAnimationFrame(frame);
      if (!running) return;
      const elapsed = now - lastT;
      if (elapsed < MIN_FRAME) return;
      lastT = now;

      const targetOpacity = heroVisible.size > 0
        ? PARAMS.opacityHero : PARAMS.opacityAmb;
      displayedOpacity += (targetOpacity - displayedOpacity) * PARAMS.fadeSpring;
      canvas.style.opacity = displayedOpacity.toFixed(3);

      const w = window.innerWidth, h = window.innerHeight;
      ctx.clearRect(0, 0, w, h);
      ctx.lineCap = "round"; ctx.lineJoin = "round";

      const r = PARAMS.driftRadius * Math.min(w, h);
      const tt = (now - t0) * PARAMS.driftSpeed;
      const N = PARAMS.samples;

      for (const stack of stacks) {
        // Bake polyline to pixel space with per-point drift.
        for (let i = 0; i < N; i++) {
          const d = stack.drift[i];
          const dax = Math.cos(tt * d.fxA + d.pxA) * r;
          const day = Math.sin(tt * d.fyA + d.pyA) * r;
          const dbx = Math.cos(tt * d.fxB + d.pxB) * r;
          const dby = Math.sin(tt * d.fyB + d.pyB) * r;
          stack.drawAx[i] = stack.archA[i].x * w + dax;
          stack.drawAy[i] = stack.archA[i].y * h + day;
          stack.drawBx[i] = stack.archB[i].x * w + dbx;
          stack.drawBy[i] = stack.archB[i].y * h + dby;
        }
        drawStack(stack);
      }
    }
    requestAnimationFrame(frame);

    function applyParams(patch) {
      Object.assign(PARAMS, patch);
    }

    window.HarmonicBG = {
      PARAMS, applyParams, ARCHETYPES,
      get stacks() { return stacks; }
    };
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }
})();
