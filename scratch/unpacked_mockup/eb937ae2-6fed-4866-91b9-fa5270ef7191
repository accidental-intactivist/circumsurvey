// ========================================================================
// CIRCUMSURVEY — scroll observers, animations, theme switching
// ========================================================================

(function() {
  const D = window.CS_DATA;
  const A = window.Art;

  // ---------- THEME ----------
  const themes = ["phosphor", "amber", "pbs", "paper", "mono"];
  const themeLabel = { phosphor: "PHOSPHOR", amber: "AMBER", pbs: "PBS", paper: "PAPER", mono: "MONO" };

  function applyTheme(t) {
    document.documentElement.setAttribute("data-theme", t);
    localStorage.setItem("cs-theme", t);
    document.querySelectorAll(".theme-pills button").forEach(b => {
      b.setAttribute("aria-pressed", b.dataset.theme === t ? "true" : "false");
    });
    // Re-render decorative art that depended on theme colors
    renderArtPanels();
  }

  function buildTopbar() {
    const bar = document.querySelector(".topbar .theme-pills");
    if (!bar) return;
    themes.forEach(t => {
      const b = document.createElement("button");
      b.dataset.theme = t;
      b.textContent = themeLabel[t];
      b.addEventListener("click", () => applyTheme(t));
      bar.appendChild(b);
    });
    const saved = localStorage.getItem("cs-theme") || "phosphor";
    applyTheme(saved);
  }

  // ---------- SCROLL PROGRESS ----------
  function updateProgress() {
    const h = document.documentElement;
    const pct = Math.min(100, Math.max(0, (h.scrollTop || window.scrollY) / (h.scrollHeight - h.clientHeight) * 100));
    document.documentElement.style.setProperty("--progress", pct.toFixed(2) + "%");
    document.querySelector(".topbar .progress")?.style.setProperty("--progress", pct.toFixed(2) + "%");
  }

  // ---------- REVEAL ----------
  const revealIO = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        e.target.classList.add("in");
        revealIO.unobserve(e.target);
      }
    });
  }, { rootMargin: "0px 0px -10% 0px", threshold: 0.05 });

  function observeReveals() {
    document.querySelectorAll(".reveal:not(.in)").forEach(el => revealIO.observe(el));
  }

  // ---------- DOTPLOT ----------
  function buildDotplot(container, n = 452, opts = {}) {
    container.innerHTML = "";
    container.classList.add("dotplot");
    const { intact = 0, circ = 0, restor = 0, columns } = opts;
    if (columns) container.style.gridTemplateColumns = `repeat(${columns}, 1fr)`;
    const tally = [];
    for (let i = 0; i < intact; i++) tally.push("intact");
    for (let i = 0; i < restor; i++) tally.push("restor");
    for (let i = 0; i < circ; i++) tally.push("circ");
    while (tally.length < n) tally.push("rest");
    for (let i = 0; i < n; i++) {
      const d = document.createElement("div");
      d.className = "dot";
      d.dataset.k = tally[i];
      container.appendChild(d);
    }
  }

  function colorDotplot(container, mode) {
    const dots = container.querySelectorAll(".dot");
    dots.forEach((d, i) => {
      d.classList.remove("on", "intact", "circ", "restor");
      if (mode === "all-on") {
        d.classList.add("on");
      } else if (mode === "by-state") {
        if (d.dataset.k === "intact")  d.classList.add("intact");
        else if (d.dataset.k === "circ")  d.classList.add("circ");
        else if (d.dataset.k === "restor") d.classList.add("restor");
        else d.classList.add("on");
      }
    });
  }

  // ---------- PINNED GAP CHART ----------
  function setupGapChart() {
    const wrap = document.querySelector("[data-gap-wrap]");
    if (!wrap) return;
    const rows = wrap.querySelectorAll(".gap-row");
    const triggers = wrap.querySelectorAll("[data-gap-trigger]");

    function activateRow(i) {
      rows.forEach((r, j) => {
        if (j <= i) {
          r.classList.add("show");
          r.querySelectorAll(".gap-bar").forEach(b => {
            b.style.width = b.dataset.w;
          });
        }
      });
    }

    const io = new IntersectionObserver((entries) => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          const i = parseInt(e.target.dataset.gapTrigger, 10);
          activateRow(i);
        }
      });
    }, { rootMargin: "-30% 0px -40% 0px" });
    triggers.forEach(t => io.observe(t));
  }

  // ---------- PERCEPTIONS BAR ----------
  function setupPerceptionBars() {
    const io = new IntersectionObserver((entries) => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          const row = e.target;
          row.querySelectorAll(".perc-seg").forEach(seg => {
            seg.style.width = seg.dataset.w;
          });
          io.unobserve(row);
        }
      });
    }, { rootMargin: "0px 0px -10% 0px", threshold: 0.2 });
    document.querySelectorAll(".perception-row").forEach(r => io.observe(r));
  }

  // ---------- COUNT UP ----------
  function countUp(el) {
    const target = parseFloat(el.dataset.count);
    const dur = parseInt(el.dataset.dur || "1400", 10);
    const decimals = parseInt(el.dataset.dec || "0", 10);
    const start = performance.now();
    function frame(now) {
      const t = Math.min(1, (now - start) / dur);
      const ease = 1 - Math.pow(1 - t, 3);
      const v = target * ease;
      el.textContent = v.toFixed(decimals);
      if (t < 1) requestAnimationFrame(frame);
      else el.textContent = target.toFixed(decimals);
    }
    requestAnimationFrame(frame);
  }
  const countIO = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        countUp(e.target);
        countIO.unobserve(e.target);
      }
    });
  }, { threshold: 0.3 });

  // ---------- BOOT SEQUENCE ----------
  function bootSequence() {
    const lines = document.querySelectorAll(".boot .line");
    let i = 0;
    function next() {
      if (i >= lines.length) return;
      lines[i].classList.add("shown");
      i++;
      setTimeout(next, 280 + Math.random() * 180);
    }
    setTimeout(next, 400);
  }

  // ---------- ART PANELS ----------
  function renderArtPanels() {
    document.querySelectorAll("[data-art]").forEach(host => {
      const type = host.dataset.art;
      const size = parseInt(host.dataset.size || "320", 10);
      const c = host.dataset.color || "stroke";
      const w = parseFloat(host.dataset.weight || "0.55");
      let svg = "";
      if (type === "spiro") {
        const R = parseInt(host.dataset.r || "100", 10);
        const r = parseInt(host.dataset.subr || "33", 10);
        const d = parseInt(host.dataset.d || "60", 10);
        const loops = parseInt(host.dataset.loops || "40", 10);
        svg = A.spirograph({ size, R, r, d, color: c, width: w, loops });
      } else if (type === "concentric") {
        const n = parseInt(host.dataset.n || "18", 10);
        svg = A.concentric({ size, n, color: c, width: w });
      } else if (type === "moire") {
        svg = A.moire({ w: size, h: parseInt(host.dataset.height || (size/2), 10), gap: parseInt(host.dataset.gap || "5", 10), color1: c, color2: host.dataset.color2 || "stroke", rot: parseFloat(host.dataset.rot || "4") });
      } else if (type === "fan") {
        const n = parseInt(host.dataset.n || "60", 10);
        svg = A.radialFan({ size, n, color: c, width: w });
      } else if (type === "wave") {
        const h = parseInt(host.dataset.height || (size/2), 10);
        const n = parseInt(host.dataset.n || "28", 10);
        const amp = parseInt(host.dataset.amp || "14", 10);
        const freq = parseFloat(host.dataset.freq || "0.02");
        const phase = parseFloat(host.dataset.phase || "0");
        svg = A.waveField({ w: size, h, n, amp, freq, phase, color: c, width: w });
      } else if (type === "liss") {
        const a = parseInt(host.dataset.a || "3", 10);
        const b = parseInt(host.dataset.b || "4", 10);
        const delta = parseFloat(host.dataset.delta || (Math.PI / 2));
        svg = A.lissajous({ size, a, b, delta, color: c, width: w });
      }
      host.innerHTML = svg;
    });
  }

  // ---------- SCROLL-MORPH SPIROGRAPH ----------
  // Used in cold-open + transition: morph spirograph params as user scrolls
  function setupScrollSpiro() {
    const hosts = document.querySelectorAll("[data-spiro-morph]");
    if (!hosts.length) return;

    function updateAll() {
      hosts.forEach(host => {
        const rect = host.getBoundingClientRect();
        const winH = window.innerHeight;
        const center = rect.top + rect.height / 2;
        // progress 0..1 across the viewport
        const p = Math.max(0, Math.min(1, 1 - (center / winH)));
        const phase = parseFloat(host.dataset.phase || "0");
        // morph R/r/d
        const R = 110;
        const r = 22 + Math.sin((p + phase) * Math.PI * 2) * 10;
        const d = 40 + p * 60;
        const loops = 30 + Math.floor(p * 30);
        const color = host.dataset.color || "stroke";
        const path = A.spirographPath(R, r, d, 2400, loops);
        const svg = host.querySelector("svg");
        if (!svg) {
          host.innerHTML = `<svg viewBox="-160 -160 320 320" width="100%" preserveAspectRatio="xMidYMid meet">
            <g class="opart"><path d="${path}" class="${color}" stroke-width="0.5" /></g>
          </svg>`;
        } else {
          const pathEl = svg.querySelector("path");
          if (pathEl) pathEl.setAttribute("d", path);
        }
      });
    }
    window.addEventListener("scroll", updateAll, { passive: true });
    updateAll();
  }

  // ---------- INIT ----------
  function init() {
    buildTopbar();

    // Wire dotplots
    document.querySelectorAll("[data-dotplot]").forEach(el => {
      const n = parseInt(el.dataset.n || "452", 10);
      const cols = parseInt(el.dataset.cols || "40", 10);
      buildDotplot(el, n, {
        intact: parseInt(el.dataset.intact || "0", 10),
        circ:   parseInt(el.dataset.circ   || "0", 10),
        restor: parseInt(el.dataset.restor || "0", 10),
        columns: cols
      });
    });

    // Dotplot reveals
    const dotIO = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          const mode = e.target.dataset.dotmode || "by-state";
          colorDotplot(e.target, mode);
          dotIO.unobserve(e.target);
        }
      });
    }, { threshold: 0.2 });
    document.querySelectorAll("[data-dotplot]").forEach(el => dotIO.observe(el));

    // Count-ups
    document.querySelectorAll("[data-count]").forEach(el => countIO.observe(el));

    renderArtPanels();
    setupScrollSpiro();
    setupGapChart();
    setupPerceptionBars();
    observeReveals();
    bootSequence();

    window.addEventListener("scroll", updateProgress, { passive: true });
    updateProgress();

    // Watch for new reveal elements (in case any are deferred)
    const mut = new MutationObserver(() => observeReveals());
    mut.observe(document.body, { childList: true, subtree: true });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }
})();
